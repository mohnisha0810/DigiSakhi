# SafeSphere Environment Configuration

# Optional: Supabase Cloud Credentials
# If omitted or left empty, SafeSphere automatically operates in persistent development/demo mode
# with localStorage persistence, BroadcastChannel realtime sync across browser tabs, and full mock RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Notification Gateway
VITE_NOTIFICATION_PROVIDER=browser_push # Options: browser_push, email_simulated, sms_simulated
